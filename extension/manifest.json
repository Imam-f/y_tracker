{
  "manifest_version": 3,
  "name": "YouTube Tab Desk Connector",
  "version": "0.1.3",
  "description": "Sends your open YouTube tabs and watch progress to the local YouTube Tab Desk app.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
    "js": ["progress.js"],
    "run_at": "document_idle"
  }]
}
